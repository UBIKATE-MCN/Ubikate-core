# Copia este archivo a ".env" y ajusta los valores. NUNCA subas ".env" a GitHub.

# --- Servidor Express ---
PORT=5000
# Origen(es) del frontend permitidos por CORS, separados por comas
CORS_ORIGIN=http://localhost:3000

# --- Base de datos (MariaDB de XAMPP escuchando en el puerto 3307) ---
DB_HOST=localhost
DB_PORT=3307
DB_USER=ubikate_user
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=ubikate_db

# --- API Open Data del Ayuntamiento de Madrid ---
MADRID_API_BASE_URL=https://datos.madrid.es
MADRID_API_TOKEN=
